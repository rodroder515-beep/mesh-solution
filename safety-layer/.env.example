# Copy this file to .env for local dev (Render deployment sets these directly
# as environment variables in the dashboard/blueprint instead).

# Port this Safety Layer service listens on.
SAFETY_LAYER_PORT=5004

# Where the real Data Layer (Chunk 4) lives. Must point at its /action endpoint.
DATA_LAYER_URL=http://localhost:5003/action

# How long (seconds) a pending write waits for confirmation before auto-expiring.
CONFIRMATION_TIMEOUT_SECONDS=60

# Where the append-only audit log is written.
SAFETY_LAYER_LOG_PATH=safety_layer_actions.jsonl
