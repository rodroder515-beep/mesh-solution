# Copy this file to .env and fill in real values. Never commit .env.

# Required — your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Model used for intent classification. Update this when the tech stack doc
# (00_overview_and_architecture.md, section 5) is updated.
CLAUDE_MODEL=claude-sonnet-5

# Port this Brain Layer service listens on
PORT=5002

# Where the Brain Layer forwards action_request messages to.
#
# IMPORTANT: In the real end-to-end wiring (Chunk 6), this MUST point at the
# Safety Layer (Chunk 5), not directly at the Data Layer — otherwise write
# actions (update_stock, place_order, create_bill) will execute without the
# confirmation step. The Brain Layer intentionally does not implement
# confirmation logic itself; that's the Safety Layer's job.
#
# For standalone testing of THIS chunk before Chunk 4/5 exist, point it at
# the bundled mock Data Layer instead (npm run mock-data), which has
# NO confirmation gating — do not use that path for integration testing.
DOWNSTREAM_URL=http://localhost:5004
